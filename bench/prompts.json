{
  "_doc": "Promptimate benchmark suite. Each prompt: id, category, segments [{prompt, seconds}], expect (whole clip) and optional segment_expect (one dict or null per segment). Expectation keys and their meaning are in mcp_server/metrics.py:expectation_checks. Distances in metres, speeds in m/s, angles in degrees.",
  "prompts": [
    {"id": "walk", "category": "locomotion",
     "segments": [{"prompt": "a person walks forward", "seconds": 5}],
     "expect": {"forward_min": 4.0, "turn_max_deg": 30, "hands_up_max_frac": 0.1, "stays_upright": 1.4}},
    {"id": "jog", "category": "locomotion",
     "segments": [{"prompt": "a person jogs forward", "seconds": 5}],
     "expect": {"forward_min": 7.0, "mean_speed_min": 1.8, "turn_max_deg": 30}},
    {"id": "run", "category": "locomotion",
     "segments": [{"prompt": "a person runs forward fast", "seconds": 5}],
     "expect": {"forward_min": 10.0, "mean_speed_min": 2.5, "airborne_frames_min": 10, "turn_max_deg": 30}},
    {"id": "walk_backward", "category": "locomotion",
     "segments": [{"prompt": "a person walks backward", "seconds": 5}],
     "expect": {"backward_min": 2.0, "turn_max_deg": 45}},
    {"id": "turn_around", "category": "locomotion",
     "segments": [{"prompt": "a person walks forward, turns around and walks back", "seconds": 6}],
     "expect": {"turn_min_deg": 150, "travel_max": 3.0}},
    {"id": "walk_stop", "category": "stop",
     "segments": [{"prompt": "a person walks forward then stops and stands still", "seconds": 5}],
     "expect": {"forward_min": 1.5, "ends_stationary": 0.15}},
    {"id": "wave", "category": "gesture",
     "segments": [{"prompt": "a person waves with their right hand", "seconds": 5}],
     "expect": {"right_hand_up_frac": 0.4, "travel_max": 0.5}},
    {"id": "point", "category": "gesture",
     "segments": [{"prompt": "a person points forward with their right arm", "seconds": 4}],
     "expect": {"right_arm_extended_frac": 0.3, "travel_max": 0.5}},
    {"id": "clap", "category": "gesture",
     "segments": [{"prompt": "a person claps their hands", "seconds": 4}],
     "expect": {"clap_count_min": 3, "travel_max": 0.5}},
    {"id": "jump", "category": "fullbody",
     "segments": [{"prompt": "a person jumps up in place", "seconds": 4}],
     "expect": {"hips_rise_min": 0.15, "airborne_frames_min": 6, "travel_max": 1.0}},
    {"id": "crouch", "category": "fullbody",
     "segments": [{"prompt": "a person squats down and stands back up", "seconds": 5}],
     "expect": {"hips_drop_min": 0.35, "hips_end_min": 0.85, "travel_max": 0.5}},
    {"id": "sit_floor", "category": "fullbody",
     "segments": [{"prompt": "a person sits down on the floor", "seconds": 6}],
     "expect": {"hips_drop_min": 0.6, "hips_end_max": 0.45, "travel_max": 1.0}},
    {"id": "kick", "category": "fullbody",
     "segments": [{"prompt": "a person kicks forward with their right leg", "seconds": 4}],
     "expect": {"foot_raise_min": 0.45, "travel_max": 1.0}},
    {"id": "sad_walk", "category": "stylized",
     "segments": [{"prompt": "a person walks forward slowly and sadly with their head down", "seconds": 6}],
     "expect": {"forward_min": 1.5, "mean_speed_max": 0.9, "head_low_max": 1.53}},
    {"id": "zombie", "category": "stylized",
     "segments": [{"prompt": "a person walks forward like a zombie with both arms stretched out in front", "seconds": 6}],
     "expect": {"forward_min": 1.0, "mean_speed_max": 1.0, "arms_forward_frac": 0.5}},
    {"id": "seq_walk_stop_wave", "category": "sequence",
     "segments": [{"prompt": "a person walks forward", "seconds": 3},
                  {"prompt": "a person stops and stands still", "seconds": 2.5},
                  {"prompt": "a person waves with their right hand", "seconds": 3}],
     "segment_expect": [{"forward_min": 2.0},
                        {"ends_stationary": 0.2, "travel_max": 0.8},
                        {"right_hand_up_frac": 0.3, "travel_max": 0.5}]},
    {"id": "seq_jog_jump", "category": "sequence",
     "segments": [{"prompt": "a person jogs forward", "seconds": 3},
                  {"prompt": "a person jumps up and down in place", "seconds": 3}],
     "segment_expect": [{"forward_min": 3.5},
                        {"hips_rise_min": 0.12, "airborne_frames_min": 4, "travel_max": 1.0}]},
    {"id": "seq_sit_stand", "category": "sequence",
     "segments": [{"prompt": "a person walks forward", "seconds": 3},
                  {"prompt": "a person sits down on the floor", "seconds": 3},
                  {"prompt": "a person stands up from the floor", "seconds": 3}],
     "segment_expect": [{"forward_min": 2.0},
                        {"hips_end_max": 0.5},
                        {"hips_end_min": 0.85}]}
  ]
}
