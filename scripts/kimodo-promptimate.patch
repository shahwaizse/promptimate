+kimodo::motion_constraints read_constraints(const std::string &path) {
+    std::ifstream in(path, std::ios::binary);
+    std::int32_t header[2]{};
+    if (!in.read(reinterpret_cast<char *>(header), sizeof header) || header[0] <= 0 || header[1] <= 0 || header[0] > 100000)
+        throw std::runtime_error("cannot read constraints header");
+    const size_t values = static_cast<size_t>(header[0]) * static_cast<size_t>(header[1]);
+    kimodo::motion_constraints c;
+    c.observed.resize(values); c.mask.resize(values);
+    if (!in.read(reinterpret_cast<char *>(c.observed.data()), static_cast<std::streamsize>(values * sizeof(float))) ||
+        !in.read(reinterpret_cast<char *>(c.mask.data()), static_cast<std::streamsize>(values * sizeof(float))))
+        throw std::runtime_error("truncated constraints file");
+    for (float v : c.observed) if (!std::isfinite(v)) throw std::runtime_error("non-finite constraint value");
+    return c;
 }
 
