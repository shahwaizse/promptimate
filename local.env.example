# Machine-specific settings. Copy to `local.env` (gitignored) and edit. Real environment variables win over this file.
# Every value is optional: the defaults find tools on PATH and keep caches under .cache/ inside the clone.

# ffmpeg/ffprobe (if they are not on PATH)
# PROMPTIMATE_FFMPEG=C:\tools\ffmpeg\bin\ffmpeg.exe
# PROMPTIMATE_FFPROBE=C:\tools\ffmpeg\bin\ffprobe.exe

# H.264 encoder: auto (AMD AMF, NVIDIA NVENC, Intel QSV, else libx264), x264, or an ffmpeg encoder name
# PROMPTIMATE_VENC=auto

# Headless shorts pipeline working data: own sets/props/looks, mesh index, scenes, sign textures (rebuildable)
# PROMPTIMATE_HEADLESS_CACHE=D:\promptimate-cache\headless

# tiny-voca TTS install (folder holding venv\ and tiny-voca\weights\), used by the tv_* narrator voices
# PROMPTIMATE_TINY_VOCA=D:\promptimate-cache\tiny-voca

# Scratch folder for judge kits and debug sheets
# PROMPTIMATE_SCRATCH=D:\promptimate-cache\scratch

# Put temp files on a big drive
# TEMP=D:\tmp
# TMP=D:\tmp
